{
  "manifest_version": 3,
  "name": "Text to Speech Selector",
  "version": "1.0",
  "description": "Reads selected text aloud and shows a translation popup.",
  "permissions": [
    "contextMenus",
    "tts",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"]
    }
  ]
}
